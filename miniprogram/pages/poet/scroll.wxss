.page {
  min-height: 100vh;
  background: #f8f5ee;
  padding: 28rpx 32rpx 48rpx;
}
.head {
  margin-bottom: 28rpx;
}
.name {
  font-size: 48rpx;
  font-weight: 700;
  letter-spacing: 6rpx;
}
.meta {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #9a9384;
}
.intro {
  margin-bottom: 32rpx;
  padding: 24rpx 26rpx;
  background: #fff;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(60, 50, 30, 0.05);
}
.intro-k {
  font-size: 20rpx;
  letter-spacing: 4rpx;
  color: #b0392c;
}
.intro-tx {
  margin-top: 12rpx;
  font-size: 26rpx;
  line-height: 1.75;
  color: #4a453b;
}
.entry-ask {
  height: 84rpx;
  margin-bottom: 28rpx;
  border-radius: 42rpx;
  background: #232019;
  color: #f6f1e6;
  text-align: center;
  line-height: 84rpx;
  font-size: 28rpx;
  font-weight: 700;
}
.entry-ask.on {
  background: #b0392c;
}
.ask {
  margin-bottom: 32rpx;
  padding: 24rpx 20rpx 18rpx;
  background: #f6f1e6;
  border-radius: 28rpx;
}
.ask-note {
  text-align: center;
  font-size: 20rpx;
  color: #b7ad9c;
  margin-bottom: 16rpx;
}
.ask-lock {
  text-align: center;
  margin-bottom: 12rpx;
  font-size: 22rpx;
  color: #b0392c;
}
.ask-lock.quiet {
  color: #9a9384;
}
.ask-row {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  margin-top: 18rpx;
}
.ask-row.mine {
  justify-content: flex-end;
}
.ask-ava {
  flex: none;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #8a6230;
  color: #fff8ef;
  font-size: 22rpx;
  line-height: 64rpx;
  text-align: center;
  overflow: hidden;
}
.ask-ava.mine {
  background: #5c5142;
}
.ask-bubble {
  max-width: 78%;
  padding: 18rpx 20rpx;
  border-radius: 8rpx 22rpx 22rpx 22rpx;
  background: #fff;
  color: #3c3428;
  font-size: 26rpx;
  line-height: 1.7;
}
.ask-row.mine .ask-bubble {
  border-radius: 22rpx 8rpx 22rpx 22rpx;
  background: #efe2c4;
}
.ask-tx {
  display: block;
}
.ask-src {
  display: block;
  margin-top: 8rpx;
  font-size: 20rpx;
  color: #9a9384;
}
.ask-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 20rpx;
}
.ask-chip {
  max-width: 100%;
  padding: 12rpx 20rpx;
  border-radius: 40rpx;
  border: 1rpx solid #e4dccb;
  background: rgba(255, 255, 255, 0.7);
  font-size: 22rpx;
  color: #6b655a;
}
.ask-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 20rpx;
  padding: 8rpx 8rpx 8rpx 24rpx;
  background: #fff;
  border-radius: 48rpx;
}
.ask-in {
  flex: 1;
  height: 72rpx;
  font-size: 26rpx;
}
.ask-send {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #232019;
  color: #f6f1e6;
  text-align: center;
  line-height: 72rpx;
  font-size: 32rpx;
}
.ask-send.off {
  background: #d9d3c6;
}
.empty {
  text-align: center;
  color: #9a9384;
  font-size: 24rpx;
  padding: 80rpx 0;
}
.stage {
  display: flex;
  align-items: stretch;
}
.rail {
  width: 36rpx;
  flex: none;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.dot {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: #b0392c;
  margin-top: 10rpx;
  flex: none;
}
.line {
  width: 2rpx;
  flex: 1;
  background: #e4d8c4;
  margin: 8rpx 0;
}
.stage:last-child .line {
  background: transparent;
}
.body {
  flex: 1;
  min-width: 0;
  padding-bottom: 28rpx;
}
.age {
  font-size: 30rpx;
  font-weight: 700;
  color: #b0392c;
  letter-spacing: 2rpx;
  margin-bottom: 12rpx;
}
.poem {
  background: #fff;
  border-radius: 20rpx;
  padding: 22rpx 24rpx;
  margin-bottom: 14rpx;
  box-shadow: 0 4rpx 16rpx rgba(60, 50, 30, 0.05);
}
.pt {
  font-size: 30rpx;
  font-weight: 700;
}
.pm {
  margin-top: 6rpx;
  font-size: 20rpx;
  color: #a39c8d;
}
.pv {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #6b655a;
  line-height: 1.6;
}
