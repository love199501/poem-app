.page {
  height: 100vh;
  background: #f8f5ee;
  position: relative;
}
.loading {
  text-align: center;
  color: #9a9384;
  padding-top: 200rpx;
}

/* 步骤条 */
.stepbar {
  display: flex;
  height: 108rpx;
  padding: 0 16rpx;
  background: rgba(248, 245, 238, 0.96);
  border-bottom: 1rpx solid #e8e2d4;
}
.step {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #a39c8d;
  border-radius: 16rpx;
  margin: 10rpx 4rpx;
}
.step.on {
  color: #b0392c;
  background: #fbf1d8;
  font-weight: 700;
}
.s-k {
  font-size: 30rpx;
}
.s-l {
  font-size: 18rpx;
}

/* 滚动区 */
.body {
  height: calc(100vh - 120rpx);
}
.entry-row {
  display: flex;
  gap: 16rpx;
  margin: 8rpx 32rpx 0;
}
.entry-ask,
.entry-talk {
  height: 84rpx;
  border-radius: 42rpx;
  text-align: center;
  line-height: 84rpx;
  font-size: 28rpx;
  font-weight: 700;
}
.entry-ask {
  flex: 1.4;
  background: #232019;
  color: #f6f1e6;
}
.entry-ask.on {
  background: #b0392c;
}
.entry-talk {
  flex: 0.8;
  background: #fff;
  color: #4a453b;
  border: 1rpx solid #e4dccb;
}
.entry-talk.on {
  color: #b0392c;
  border-color: #b0392c;
}
.midbar {
  white-space: nowrap;
  margin: 12rpx 0 4rpx;
  padding: 8rpx 16rpx 0;
  border-bottom: 1rpx solid #eee6d8;
}
.mid {
  display: inline-block;
  padding: 18rpx 26rpx 20rpx;
  font-size: 28rpx;
  color: #c5bfb4;
}
.mid.on {
  color: #232019;
  font-weight: 700;
}
.ask {
  margin: 20rpx 32rpx 0;
  padding: 24rpx 20rpx 18rpx;
  background: #f6f1e6;
  border-radius: 28rpx;
}
.ask-note {
  text-align: center;
  font-size: 20rpx;
  color: #b7ad9c;
  margin-bottom: 16rpx;
}
.ask-lock {
  text-align: center;
  margin-bottom: 12rpx;
  font-size: 22rpx;
  color: #b0392c;
}
.ask-lock.quiet {
  color: #9a9384;
}
.ask-row {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  margin-top: 18rpx;
}
.ask-row.mine {
  justify-content: flex-end;
}
.ask-ava {
  flex: none;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #8a6230;
  color: #fff8ef;
  font-size: 22rpx;
  line-height: 64rpx;
  text-align: center;
  overflow: hidden;
}
.ask-ava.mine {
  background: #5c5142;
}
.ask-bubble {
  max-width: 78%;
  padding: 18rpx 20rpx;
  border-radius: 8rpx 22rpx 22rpx 22rpx;
  background: #fff;
  color: #3c3428;
  font-size: 26rpx;
  line-height: 1.7;
}
.ask-row.mine .ask-bubble {
  border-radius: 22rpx 8rpx 22rpx 22rpx;
  background: #efe2c4;
}
.ask-tx {
  display: block;
}
.ask-src {
  display: block;
  margin-top: 8rpx;
  font-size: 20rpx;
  color: #9a9384;
}
.ask-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 20rpx;
}
.ask-chip {
  max-width: 100%;
  padding: 12rpx 20rpx;
  border-radius: 40rpx;
  border: 1rpx solid #e4dccb;
  background: rgba(255, 255, 255, 0.7);
  font-size: 22rpx;
  color: #6b655a;
}
.ask-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 20rpx;
  padding: 8rpx 8rpx 8rpx 24rpx;
  background: #fff;
  border-radius: 48rpx;
}
.ask-in {
  flex: 1;
  height: 72rpx;
  font-size: 26rpx;
}
.ask-send {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #232019;
  color: #f6f1e6;
  text-align: center;
  line-height: 72rpx;
  font-size: 32rpx;
}
.ask-send.off {
  background: #d9d3c6;
}
.anchor {
  height: 1rpx;
}
.lead {
  display: flex;
  align-items: center;
  margin: 36rpx 32rpx 4rpx;
  font-size: 26rpx;
  font-weight: 700;
}
.lead-k {
  width: 48rpx;
  height: 48rpx;
  border-radius: 14rpx;
  background: #b0392c;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  margin-right: 16rpx;
}

/* 读 */
.poem-head {
  padding: 8rpx 36rpx 0;
}
.poem-title {
  font-size: 54rpx;
  font-weight: 700;
  letter-spacing: 6rpx;
}
.poem-author {
  font-size: 22rpx;
  color: #9a9384;
  margin: 14rpx 0 16rpx;
}
.author-link {
  color: #b0392c;
  margin-left: 8rpx;
}
/* 受欢迎度：点赞 / 收藏 / 评论 */
.pop {
  display: flex;
  gap: 40rpx;
  margin-top: 20rpx;
}
.pop-i {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
  color: #8c8577;
}
.pop-ic {
  font-size: 26rpx;
  color: #b0392c;
}
.pop-i.like .pop-ic {
  color: #c9c2b3;
}
.pop-i.like.on .pop-ic {
  color: #b0392c;
}
.pop-n {
  font-size: 26rpx;
  font-weight: 700;
  color: #4a453b;
}
.pop-l {
  font-size: 20rpx;
  color: #a8a194;
}
.poem-body {
  padding: 20rpx 36rpx 0;
}
.poem-line {
  color: #2f2b23;
  padding: 14rpx 4rpx;
  text-align: center;
  white-space: nowrap;
  line-height: 1.6;
}
.poem-line.with-py {
  padding-top: 36rpx;
}
.poem-text {
  letter-spacing: 0.04em;
}
.py-ch {
  display: inline-block;
  position: relative;
  width: 1em;
  vertical-align: bottom;
}
.py {
  position: absolute;
  left: 50%;
  bottom: 100%;
  transform: translateX(-50%);
  font-size: 18rpx;
  line-height: 1.2;
  color: #a09078;
  font-family: -apple-system, "PingFang SC", sans-serif;
  letter-spacing: 0;
  white-space: nowrap;
}
.poem-line.active {
  background: #fbf1d8;
  color: #8a2c1f;
  border-radius: 10rpx;
}
.poem-tip {
  font-size: 20rpx;
  color: #b4ada0;
  text-align: center;
  margin-top: 14rpx;
}
.poem-illust-wrap {
  margin: 20rpx 32rpx 4rpx;
  border-radius: 20rpx;
  overflow: hidden;
  background: linear-gradient(180deg, #fbf8f1, #f3ecda);
  border: 1rpx solid #ece3cf;
  position: relative;
}
.poem-illust {
  width: 100%;
  display: block;
}
.poem-illust-cap {
  position: absolute;
  right: 18rpx;
  bottom: 14rpx;
  font-size: 20rpx;
  color: #8a7f68;
  letter-spacing: 2rpx;
}
.fold {
  background: #fff;
  border-radius: 24rpx;
  margin: 24rpx 32rpx 0;
  padding: 26rpx;
  box-shadow: 0 4rpx 18rpx rgba(60, 50, 30, 0.06);
}
.fold-head {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  font-weight: 700;
}
.fold-head .dot {
  width: 6rpx;
  height: 26rpx;
  background: #b0392c;
  border-radius: 4rpx;
  margin-right: 16rpx;
}
.fold-head .chev {
  margin-left: auto;
  font-size: 20rpx;
  color: #9a9384;
}
.note-line {
  font-size: 27rpx;
  color: #8a2c1f;
  margin: 18rpx 0 10rpx;
}
.note-body {
  font-size: 26rpx;
  line-height: 1.9;
  color: #5b554a;
}
.note-src {
  font-size: 20rpx;
  color: #a8a294;
  margin-top: 18rpx;
  padding-top: 16rpx;
  border-top: 1rpx dashed #f0ebdf;
}
.trans {
  margin-top: 18rpx;
}
.trans-p {
  font-size: 26rpx;
  line-height: 1.9;
  color: #5b554a;
  margin-bottom: 12rpx;
}

/* 境 */
.scene {
  margin: 10rpx 32rpx 0;
  border-radius: 28rpx;
  padding: 32rpx;
  color: #efe7d5;
  background: linear-gradient(160deg, #312d25, #4d4434 70%, #5f4d33);
}
.scene-title {
  font-size: 32rpx;
  letter-spacing: 4rpx;
}
.scene-sub {
  font-size: 20rpx;
  color: #a99d82;
  letter-spacing: 4rpx;
  margin-bottom: 24rpx;
}
.scene-row {
  display: flex;
  font-size: 24rpx;
  line-height: 1.7;
  margin-bottom: 14rpx;
  color: #ded4bd;
}
.scene-row .ic {
  width: 40rpx;
  flex: none;
}
.scene-bg {
  margin-top: 8rpx;
  padding-top: 22rpx;
  border-top: 1rpx dashed rgba(255, 255, 255, 0.16);
}
.scene-bg-k {
  display: block;
  font-size: 20rpx;
  letter-spacing: 6rpx;
  color: #c9b78f;
  margin-bottom: 12rpx;
}
.scene-bg-tx {
  display: block;
  font-size: 26rpx;
  line-height: 1.9;
  color: #f3ead8;
}
.scene-punch {
  margin-top: 22rpx;
  font-size: 27rpx;
  line-height: 1.7;
  color: #e6c98a;
}
.card {
  background: #fff;
  border-radius: 28rpx;
  margin: 24rpx 32rpx 0;
  padding: 30rpx;
  box-shadow: 0 4rpx 18rpx rgba(60, 50, 30, 0.06);
}
/* 意 */
.intent-lead {
  margin: 10rpx 32rpx 0;
  padding: 36rpx;
  border-radius: 28rpx;
  background: linear-gradient(150deg, #fdf8ec, #f4ecda);
  border: 1rpx solid #ece0c6;
}
.il-q {
  font-size: 32rpx;
  line-height: 1.8;
  color: #3b3226;
}
.il-s {
  font-size: 22rpx;
  color: #9c9282;
  margin-top: 18rpx;
  line-height: 1.7;
}
.why {
  display: flex;
  padding: 18rpx 0;
  border-top: 1rpx dashed #f2ecdf;
}
.why:first-child {
  border-top: none;
  padding-top: 0;
}
.why-n {
  width: 40rpx;
  height: 40rpx;
  flex: none;
  border-radius: 50%;
  background: #fbf1d8;
  color: #a8791f;
  font-size: 22rpx;
  text-align: center;
  line-height: 40rpx;
  margin-right: 18rpx;
}
.why-t {
  font-size: 25rpx;
  line-height: 1.7;
  color: #544e43;
}
.why-t .b {
  color: #232019;
  font-weight: 700;
}
.strat-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 0 32rpx;
  gap: 18rpx;
}
.strat {
  width: calc(50% - 9rpx);
  background: #fff;
  border-radius: 24rpx;
  padding: 24rpx;
  box-sizing: border-box;
  box-shadow: 0 4rpx 18rpx rgba(60, 50, 30, 0.06);
}
.st-n {
  font-size: 26rpx;
  font-weight: 700;
  color: #b0392c;
  margin-bottom: 12rpx;
}
.st-d {
  font-size: 21rpx;
  line-height: 1.7;
  color: #7d7669;
}
.aud {
  display: flex;
  margin-bottom: 18rpx;
}
.aud:last-child {
  margin-bottom: 0;
}
.ar {
  font-size: 20rpx;
  color: #fff;
  background: #3f6f62;
  border-radius: 10rpx;
  padding: 2rpx 14rpx;
  flex: none;
  align-self: flex-start;
  margin-right: 16rpx;
}
.aud-t {
  font-size: 24rpx;
  line-height: 1.7;
  color: #544e43;
}
.void {
  margin: 0 32rpx;
  background: #fbf8f1;
  border: 1rpx dashed #ddd2bc;
  border-radius: 28rpx;
  padding: 30rpx;
  font-size: 25rpx;
  line-height: 1.9;
  color: #5b554a;
}

/* 悟 */
.layer-t {
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  margin-bottom: 14rpx;
}
.layer-b {
  font-size: 25rpx;
  line-height: 1.9;
  color: #544e43;
}
.quote {
  margin: 0 32rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 26rpx 28rpx;
  border-left: 6rpx solid #c9a227;
  box-shadow: 0 4rpx 18rpx rgba(60, 50, 30, 0.06);
}
/* 名家诗话 · 横向滑动 */
.quote-scroll {
  white-space: nowrap;
  padding: 4rpx 32rpx;
}
.quote.hcard {
  display: inline-block;
  vertical-align: top;
  white-space: normal;
  width: 80%;
  margin: 0 16rpx 0 0;
  box-sizing: border-box;
}
.qt {
  font-size: 26rpx;
  line-height: 1.9;
  color: #4a453b;
}
.qs {
  font-size: 20rpx;
  color: #9a9384;
  margin-top: 14rpx;
  text-align: right;
}
.duel {
  display: flex;
  gap: 18rpx;
  padding: 0 32rpx;
  margin-top: 24rpx;
}
.duel .d {
  flex: 1;
  background: #fff;
  border-radius: 24rpx;
  padding: 24rpx;
  box-shadow: 0 4rpx 18rpx rgba(60, 50, 30, 0.06);
}
.duel .dh {
  font-size: 22rpx;
  font-weight: 700;
  margin-bottom: 14rpx;
  padding-bottom: 12rpx;
  border-bottom: 1rpx dashed #e8e2d4;
}
.duel .d.a .dh {
  color: #b0392c;
}
.duel .d.b .dh {
  color: #3f6f62;
}
.duel .dp {
  font-size: 22rpx;
  line-height: 1.8;
  color: #615b4f;
}

/* 议 · 讨论区 */
.talk-bar {
  display: flex;
  gap: 32rpx;
  align-items: center;
  padding: 20rpx 32rpx 4rpx;
  font-size: 24rpx;
  color: #9a9384;
}
.talk-bar .tb.on {
  color: #232019;
  font-weight: 700;
}
.comment {
  display: flex;
  margin: 0 32rpx;
  padding: 28rpx 0;
  border-bottom: 1rpx solid #f0ebdf;
}
.comment.pinned {
  margin: 12rpx 32rpx 4rpx;
  padding: 26rpx;
  border-bottom: none;
  border-radius: 24rpx;
  background: linear-gradient(180deg, #fdf8ec, #f7f0dd);
  border: 1rpx solid #ecdfbf;
}
.av {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  flex: none;
  color: #fff;
  font-size: 26rpx;
  text-align: center;
  line-height: 64rpx;
  margin-right: 18rpx;
  font-family: "Songti SC", serif;
}
.cm {
  flex: 1;
  min-width: 0;
}
.cn {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 6rpx 0;
  font-size: 24rpx;
  font-weight: 600;
  color: #4a453b;
}
.cn-name {
  margin-right: 4rpx;
}
.badge {
  font-size: 18rpx;
  background: #fbf1d8;
  color: #a8791f;
  padding: 2rpx 12rpx;
  border-radius: 10rpx;
  font-weight: 400;
  margin-left: 10rpx;
}
.badge.gold {
  background: #c9a227;
  color: #fff;
}
/* 尺寸在此，配色来自全局 .lv-t1…t5（等级越高越醒目） */
.lv-badge {
  font-size: 18rpx;
  font-weight: 400;
  padding: 2rpx 12rpx;
  border-radius: 10rpx;
  margin-left: 8rpx;
}
.lv-badge.sm {
  font-size: 17rpx;
  padding: 1rpx 10rpx;
}
.ct {
  font-size: 25rpx;
  line-height: 1.75;
  color: #5b554a;
  margin: 12rpx 0 16rpx;
}
.cf {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-top: 6rpx;
}
.act {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 10rpx 16rpx;
  border-radius: 28rpx;
  font-size: 23rpx;
  color: #9a9384;
  line-height: 1;
}
.act .act-ic {
  font-size: 28rpx;
  line-height: 1;
}
.act .act-n {
  font-size: 23rpx;
  line-height: 1;
}
.act.like.on {
  color: #b0392c;
  background: #fbeeec;
  font-weight: 600;
}
.act-hover {
  opacity: 0.55;
}

/* 楼中楼回复 */
.replies {
  margin-top: 16rpx;
  padding: 16rpx 18rpx;
  background: #faf7f0;
  border-radius: 16rpx;
}
.reply-item {
  display: flex;
  gap: 14rpx;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #f0ebdf;
}
.reply-item:last-of-type {
  border-bottom: none;
}
.rp-av {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  flex: none;
  color: #fff;
  font-size: 20rpx;
  text-align: center;
  line-height: 44rpx;
  font-family: "Songti SC", serif;
}
.rp-body {
  flex: 1;
  min-width: 0;
}
.rp-head {
  display: flex;
  align-items: center;
  gap: 10rpx;
}
.rp-name {
  font-size: 22rpx;
  font-weight: 600;
  color: #4a453b;
}
.rp-to {
  font-size: 20rpx;
  color: #9a9384;
}
.rp-ct {
  font-size: 24rpx;
  line-height: 1.7;
  color: #5b554a;
  margin: 8rpx 0 6rpx;
}
.rp-cf {
  display: flex;
  align-items: center;
  gap: 10rpx;
}
.rp-cf .act {
  padding: 6rpx 10rpx;
  font-size: 21rpx;
}
.rp-cf .act .act-ic {
  font-size: 24rpx;
}
.reply-more {
  font-size: 22rpx;
  color: #b0392c;
  padding: 12rpx 4rpx 2rpx;
}




/* 写评论 */
.talk-input {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin: 24rpx 32rpx 0;
  background: #f5f1e7;
  border-radius: 44rpx;
  padding: 18rpx 28rpx;
}
.ti-in {
  flex: 1;
  font-size: 24rpx;
}
.ti-send {
  font-size: 24rpx;
  color: #fff;
  background: #232019;
  border-radius: 30rpx;
  padding: 10rpx 24rpx;
}

/* 常驻朗诵条 */
.audio-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  height: 120rpx;
  display: flex;
  align-items: center;
  gap: 22rpx;
  padding: 0 28rpx;
  background: rgba(32, 29, 22, 0.96);
  color: #f0e8d6;
}
.audio-bar.actions {
  justify-content: flex-end;
}
.ab-play {
  width: 60rpx;
  height: 60rpx;
  flex: none;
  border-radius: 50%;
  background: #f0e8d6;
  color: #232019;
  text-align: center;
  line-height: 60rpx;
  font-size: 24rpx;
}
.ab-mid {
  flex: 1;
  min-width: 0;
}
.ab-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 10rpx;
}
.ab-title {
  font-size: 22rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.ab-time {
  font-size: 20rpx;
  color: #b7ab92;
  flex: none;
}
.ab-track {
  height: 6rpx;
  background: rgba(240, 232, 214, 0.25);
  border-radius: 4rpx;
  overflow: hidden;
}
.ab-i {
  width: 34%;
  height: 100%;
  background: #c9a227;
  transition: width 0.25s linear;
}
/* 朗诵条内的收藏入口 */
.ab-fav {
  flex: none;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 84rpx;
  height: 84rpx;
  border-radius: 20rpx;
  background: rgba(240, 232, 214, 0.12);
  border: 1rpx solid rgba(240, 232, 214, 0.28);
  color: #e6d2a6;
}
.ab-fav.on {
  background: linear-gradient(135deg, #c9873f, #b0392c);
  border-color: transparent;
  color: #fff4e2;
}
.ab-like.on {
  background: #b0392c;
  border-color: transparent;
  color: #fff;
}
.ab-fav-ic {
  font-size: 32rpx;
  line-height: 1;
}
.ab-fav-tx {
  font-size: 17rpx;
  margin-top: 4rpx;
}

/* 通用标题（页面内复用） */
.tags {
  margin-top: 4rpx;
}

.share-entry {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  margin: 28rpx 32rpx 0;
  height: 80rpx;
  border-radius: 40rpx;
  background: #fff;
  color: #4a453b;
  font-size: 26rpx;
  box-shadow: 0 4rpx 18rpx rgba(60, 50, 30, 0.06);
}
.share-entry-seal {
  width: 36rpx;
  height: 36rpx;
  border: 2rpx solid #b0392c;
  border-radius: 6rpx;
  color: #b0392c;
  font-size: 22rpx;
  line-height: 36rpx;
  text-align: center;
}

.share-mask {
  position: fixed;
  inset: 0;
  z-index: 80;
  background: rgba(28, 24, 18, 0.55);
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
}
.share-sheet {
  background: #f8f5ee;
  border-radius: 36rpx 36rpx 0 0;
  padding: 36rpx 36rpx 48rpx;
}
.share-h {
  text-align: center;
  font-size: 28rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  margin-bottom: 28rpx;
}
.share-card {
  position: relative;
  overflow: hidden;
  min-height: 460rpx;
  border-radius: 28rpx;
  padding: 40rpx 36rpx 32rpx;
  display: flex;
  flex-direction: column;
  align-items: stretch;
  border: 1rpx solid rgba(176, 57, 44, 0.12);
}
.share-top {
  display: flex;
  align-items: flex-start;
  min-height: 340rpx;
}
.share-bg {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}
.share-bg-mask {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(160deg, rgba(22, 18, 14, 0.72) 0%, rgba(28, 24, 18, 0.46) 55%, rgba(20, 16, 12, 0.68) 100%);
}
.theme-illust {
  background: #2a261f;
  color: #f0e8d6;
}
.theme-illust .seal {
  border-color: rgba(244, 240, 230, 0.92);
  color: #f4f0e6;
}
.theme-illust .qr-cap {
  color: rgba(240, 232, 214, 0.82);
}
.theme-illust .qr-fallback {
  background: rgba(255, 255, 255, 0.16);
}
.share-ring {
  position: absolute;
  right: -80rpx;
  bottom: -120rpx;
  width: 280rpx;
  height: 280rpx;
  border-radius: 50%;
  border: 1rpx solid rgba(176, 57, 44, 0.16);
}
.theme-paper { background: linear-gradient(165deg, #fdfaf1, #f3ecda); color: #2e2a22; }
.theme-night { background: linear-gradient(165deg, #3a342c, #221e18); color: #f0e8d6; border-color: rgba(230, 201, 138, 0.2); }
.theme-night .share-ring { border-color: rgba(230, 201, 138, 0.2); }
.theme-green { background: linear-gradient(165deg, #f3f8f5, #d7e8de); color: #1e3a32; border-color: rgba(47, 111, 94, 0.16); }
.theme-green .share-ring { border-color: rgba(47, 111, 94, 0.18); }
.theme-cinnabar { background: linear-gradient(165deg, #fdf6f3, #f3ddd6); color: #4a221c; }
.vcols {
  display: flex;
  flex-direction: row-reverse;
  align-items: flex-start;
  gap: 36rpx;
  z-index: 1;
  padding-top: 8rpx;
}
.vcol {
  display: flex;
  flex-direction: column;
  align-items: center;
}
.vch {
  font-size: 42rpx;
  line-height: 1.55;
  letter-spacing: 4rpx;
}
.share-side {
  margin-left: auto;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  z-index: 1;
}
.seal {
  width: 96rpx;
  height: 96rpx;
  border: 3rpx solid #b0392c;
  border-radius: 10rpx;
  color: #b0392c;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  line-height: 1.2;
  letter-spacing: 2rpx;
  transform: rotate(-6deg);
}
.theme-night .seal { border-color: #e6c98a; color: #e6c98a; }
.theme-green .seal { border-color: #2f6f5e; color: #2f6f5e; }
.qr-img, .qr-fallback {
  width: 112rpx;
  height: 112rpx;
  margin-top: 20rpx;
  border-radius: 8rpx;
  background: rgba(46, 42, 34, 0.08);
}
.qr-cap {
  margin-top: 10rpx;
  font-size: 18rpx;
  letter-spacing: 2rpx;
  color: #a49d8e;
}
.share-quote {
  position: relative;
  z-index: 1;
  margin-top: 28rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid rgba(46, 42, 34, 0.12);
}
.theme-illust .share-quote,
.theme-night .share-quote {
  border-top-color: rgba(240, 232, 214, 0.28);
}
.share-quote-k {
  display: block;
  font-size: 20rpx;
  letter-spacing: 4rpx;
  opacity: 0.72;
}
.share-quote-tx {
  display: block;
  margin-top: 10rpx;
  font-size: 26rpx;
  line-height: 1.65;
}
.share-quote-src {
  display: block;
  margin-top: 8rpx;
  font-size: 20rpx;
  opacity: 0.7;
}
.share-foot {
  position: relative;
  z-index: 1;
  margin-top: 22rpx;
  font-size: 22rpx;
  opacity: 0.86;
}
.theme-row {
  display: flex;
  justify-content: center;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 28rpx;
}
.theme-chip {
  font-size: 24rpx;
  padding: 10rpx 28rpx;
  border-radius: 40rpx;
  background: #f1ece0;
  color: #5c564c;
}
.theme-chip.on {
  background: #2e2a22;
  color: #e6dcc4;
}
.share-acts {
  display: flex;
  gap: 20rpx;
  margin-top: 32rpx;
}
.sa {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 44rpx;
  font-size: 28rpx;
  margin: 0;
  padding: 0;
}
.sa::after { border: none; }
.sa.ghost {
  background: #fff;
  color: #3c3830;
  border: 1rpx solid #e4dccb;
}
.sa.primary {
  background: #232019;
  color: #f6f1e6;
}
.share-note {
  text-align: center;
  margin-top: 20rpx;
  font-size: 22rpx;
  color: #a49d8e;
}
.share-canvas {
  position: fixed;
  left: -2000px;
  top: 0;
  width: 640px;
  height: 1000px;
}
.illust-preload {
  position: fixed;
  left: -2000px;
  top: 0;
  width: 8px;
  height: 8px;
}





