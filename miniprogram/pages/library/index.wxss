.lib {
  min-height: 100vh;
  background: #f8f5ee;
  padding-bottom: 40rpx;
}

.search {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin: 20rpx 32rpx 12rpx;
  background: #fff;
  border-radius: 40rpx;
  padding: 16rpx 28rpx;
  box-shadow: 0 4rpx 16rpx rgba(60, 50, 30, 0.05);
}
.search-input {
  flex: 1;
  font-size: 26rpx;
}
.search-btn {
  font-size: 26rpx;
  color: #b0392c;
}

.filter {
  padding: 8rpx 32rpx 4rpx;
}
.f-row {
  display: flex;
  align-items: center;
  margin-bottom: 14rpx;
}
.f-k {
  font-size: 22rpx;
  color: #9a9384;
  width: 70rpx;
  flex: none;
}
.chips {
  white-space: nowrap;
  flex: 1;
  min-width: 0;
  padding-right: 32rpx;
  box-sizing: border-box;
}
.chip {
  display: inline-block;
  font-size: 24rpx;
  padding: 10rpx 24rpx;
  border-radius: 32rpx;
  background: #fff;
  color: #7a7263;
  border: 1rpx solid #e8e2d4;
  margin-right: 14rpx;
}
.chip:last-child {
  margin-right: 0;
}
.chip.on {
  background: #232019;
  color: #f3ecdc;
  border-color: #232019;
}

.item {
  display: flex;
  align-items: center;
  margin: 0 32rpx;
  padding: 28rpx 0;
  border-bottom: 1rpx solid #f0ebdf;
}
.li-main {
  flex: 1;
  min-width: 0;
}
.li-t {
  font-size: 32rpx;
  font-weight: 700;
  margin-bottom: 6rpx;
}
.li-a {
  font-size: 22rpx;
  color: #9a9384;
  margin-bottom: 12rpx;
}
.li-v {
  font-size: 26rpx;
  color: #6b655a;
  margin-bottom: 14rpx;
}
.li-pop {
  display: flex;
  gap: 24rpx;
  margin-top: 12rpx;
}
.lp {
  font-size: 20rpx;
  color: #a8a194;
}
.li-m {
  font-size: 34rpx;
  color: #c9c2b3;
  margin-left: 16rpx;
}
.empty {
  text-align: center;
  color: #9a9384;
  font-size: 24rpx;
  margin-top: 80rpx;
}
