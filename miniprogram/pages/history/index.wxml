<view class="page">
  <view class="head">
    <view class="title serif">历史卷轴</view>
    <view class="sub">点开朝代，看诗人何时出场</view>
  </view>

  <view wx:if="{{loading}}" class="empty">展开卷轴…</view>
  <view wx:elif="{{!dynasties.length}}" class="empty">还没有可展示的朝代</view>

  <view wx:for="{{dynasties}}" wx:key="name" class="era">
    <view class="rail">
      <view class="dot {{open===item.name?'on':''}}"></view>
      <view class="line"></view>
    </view>
    <view class="body">
      <view class="era-hd" data-name="{{item.name}}" bindtap="toggle">
        <text class="era-name serif">{{item.name}}</text>
        <text class="era-meta">{{item.poetCount}} 人 · {{item.poemCount}} 首</text>
        <text class="era-chev">{{open===item.name?'▴':'▾'}}</text>
      </view>
      <view wx:if="{{open===item.name}}" class="periods">
        <view wx:for="{{item.periods}}" wx:for-item="pd" wx:key="name" class="period">
          <view wx:if="{{pd.name}}" class="period-name">{{pd.name}}</view>
          <view
            wx:for="{{pd.poets}}"
            wx:for-item="p"
            wx:key="name"
            class="slot"
            data-author="{{p.name}}"
            data-dynasty="{{item.name}}"
            bindtap="goPoet"
          >
            <text class="slot-year">{{p.yearText || '—'}}</text>
            <view class="slot-body">
              <text class="slot-name serif">{{p.name}}</text>
              <text wx:if="{{p.verse}}" class="slot-verse serif">{{p.verse}}</text>
            </view>
          </view>
        </view>
      </view>
    </view>
  </view>
</view>
