.page {
  min-height: 100vh;
  background: #f8f5ee;
  padding: 28rpx 32rpx 48rpx;
}
.head {
  margin-bottom: 28rpx;
}
.title {
  font-size: 48rpx;
  font-weight: 700;
  letter-spacing: 6rpx;
}
.sub {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #9a9384;
}
.empty {
  text-align: center;
  color: #9a9384;
  font-size: 24rpx;
  padding: 80rpx 0;
}
.era {
  display: flex;
  align-items: stretch;
}
.rail {
  width: 36rpx;
  flex: none;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  border: 3rpx solid #b0392c;
  background: #f8f5ee;
  margin-top: 14rpx;
  flex: none;
}
.dot.on {
  background: #b0392c;
}
.line {
  width: 2rpx;
  flex: 1;
  background: #e4d8c4;
  margin: 8rpx 0;
}
.era:last-child .line {
  background: transparent;
}
.body {
  flex: 1;
  min-width: 0;
  padding-bottom: 12rpx;
}
.era-hd {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
  padding: 8rpx 0 16rpx;
}
.era-name {
  font-size: 34rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
}
.era-meta {
  flex: 1;
  font-size: 20rpx;
  color: #a39c8d;
}
.era-chev {
  font-size: 22rpx;
  color: #b0392c;
}
.periods {
  padding: 0 0 24rpx;
}
.period-name {
  margin: 18rpx 0 8rpx;
  text-align: center;
  font-size: 22rpx;
  letter-spacing: 6rpx;
  color: #8a2c1f;
}
.slot {
  display: flex;
  gap: 16rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid rgba(196, 176, 140, 0.45);
}
.slot-year {
  width: 78rpx;
  flex: none;
  padding-top: 6rpx;
  font-size: 22rpx;
  color: #a09078;
  font-variant-numeric: tabular-nums;
}
.slot-body {
  flex: 1;
  min-width: 0;
}
.slot-name {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}
.slot-verse {
  display: block;
  margin-top: 6rpx;
  font-size: 24rpx;
  line-height: 1.65;
  color: #6d6558;
}
