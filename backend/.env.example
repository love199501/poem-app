# 环境变量示例，复制为 .env 或直接导出到环境
# MySQL DSN 组成部分
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=123456
DB_NAME=shijing

# 服务端口
APP_PORT=8080

# 是否在启动时自动迁移并写入种子数据（true/false）
AUTO_MIGRATE=true
SEED=true

# 网页后台(/admin)登录口令
ADMIN_KEY=admin123

# 大模型（OpenAI 兼容接口）。LLM_API_KEY 为空时后台用本地 mock 生成。
# 推荐(方案A·一个平台一个Key)：硅基流动托管的 DeepSeek，文本+插画共用同一个 key。
#   LLM_BASE_URL=https://api.siliconflow.cn/v1  LLM_MODEL=deepseek-ai/DeepSeek-V3
# 也可用 DeepSeek 官方：https://api.deepseek.com/v1 ，模型 deepseek-chat（但不含文生图）。
LLM_BASE_URL=https://api.siliconflow.cn/v1
LLM_API_KEY=sk-yzqxlupikjrsizolztmhgehrbtlijnanjnspkxmgewaxqepy
LLM_MODEL=deepseek-ai/DeepSeek-V3

# 情感朗诵合成（OpenAI 兼容 /audio/speech）。为空则小程序回退到基础插件TTS(机械音)。
# 可用：OpenAI(gpt-4o-mini-tts，支持 instructions 控制情感) / 硅基流动 / 火山 等兼容服务。
# 注意：DeepSeek 没有 TTS，不能复用上面的 Key。
TTS_BASE_URL=https://api.openai.com/v1
TTS_API_KEY=
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=onyx

# 朗诵供应商：volcano_bigtts(豆包大模型·推荐) / volcano(经典) / azure / openai / 留空=自动
TTS_PROVIDER=volcano_bigtts
# 豆包大模型语音（seed-tts，只需一个 X-Api-Key，无需 AppID）
VOLC_API_KEY=bf9afbbb-160a-4d4b-9299-3d64fa30678a
VOLC_RESOURCE_ID=seed-tts-2.0
# 换成有感情的音色（在豆包控制台「音色列表」里确认你已开通的，复制其 speaker id）
VOLC_SPEAKER=zh_female_roumeinvyou_emo_v2_mars_bigtts
# 语速：-50~100，负值更慢；诗词朗诵建议 -25 左右
VOLC_SPEECH_RATE=-25
# 情感（需所选音色支持）：如 affectionate(深情)/sad/gentle/warm，留空=音色默认
VOLC_BIG_EMOTION=affectionate

# Azure 语音服务（zh-CN-XiaoxiaoNeural 支持 poetry-reading 诗歌朗诵风格）
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus
AZURE_VOICE=zh-CN-XiaoxiaoNeural
AZURE_STYLE=poetry-reading

# 字节火山引擎·经典语音合成（需 AppID + Access Token，音色需在应用下开通）
VOLC_APPID=
VOLC_ACCESS_TOKEN=
VOLC_CLUSTER=volcano_tts
VOLC_VOICE_TYPE=BV001_streaming
# 可选情感（需所选音色支持多情感），如 sad / happy / 留空
VOLC_EMOTION=

# 文生图（人物水墨插画，OpenAI 兼容 /images/generations）。为空则不生成插画。
# 方案A推荐：硅基流动 Kolors，与上面的 LLM 共用同一个硅基流动 key（一个平台搞定文本+图）。
# DeepSeek 无文生图，故用同平台的 Kolors 出图；OpenAI 可改 dall-e-3。
IMG_BASE_URL=https://api.siliconflow.cn/v1
IMG_API_KEY=sk-yzqxlupikjrsizolztmhgehrbtlijnanjnspkxmgewaxqepy
IMG_MODEL=Kwai-Kolors/Kolors
IMG_SIZE=1024x1024
# 插画检索：baidu=先用百度图片检索现成国画(大模型生成检索词)，取不到再按诗意生成；off=直接生成
IMG_SEARCH=baidu
