# 环境变量示例，复制为 .env 或直接导出到环境
# MySQL DSN 组成部分
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=123456
DB_NAME=shijing

# 服务端口
APP_PORT=8080

# 是否在启动时自动迁移并写入种子数据（true/false）
AUTO_MIGRATE=true
SEED=true

# 评论云控：false=隐藏评论入口（提审用）；过审后改为 true 并重启，无需再发版
COMMENT_ENABLED=false

# 在线播放云控：false=隐藏朗诵入口。取得额外资质后改为 true 并重启，无需再发版
AUDIO_ENABLED=false

# 微信小程序登录（配置后 /api/login 走真实 jscode2session 换 openid；留空则开发兜底用 code 当伪 openid）
WECHAT_APPID=wxe62f306ecc5f5d46
WECHAT_SECRET=50d1a7c11e3b99bcd5d63e1c35c744dc

# 网页后台(/admin)登录口令
ADMIN_KEY=admin123

# 大模型（OpenAI 兼容接口）。LLM_API_KEY 为空时后台用本地 mock 生成。
# 推荐(方案A·一个平台一个Key)：硅基流动托管的 DeepSeek，文本+插画共用同一个 key。
#   LLM_BASE_URL=https://api.siliconflow.cn/v1  LLM_MODEL=deepseek-ai/DeepSeek-V3
# 也可用 DeepSeek 官方：https://api.deepseek.com/v1 ，模型 deepseek-chat（但不含文生图）。
LLM_BASE_URL=https://api.siliconflow.cn/v1
LLM_API_KEY=sk-yzqxlupikjrsizolztmhgehrbtlijnanjnspkxmgewaxqepy
LLM_MODEL=deepseek-ai/DeepSeek-V3

# 朗诵：硅基流动 CosyVoice。TTS_API_KEY 留空时复用上面的 LLM_API_KEY。
TTS_BASE_URL=https://api.siliconflow.cn/v1
TTS_API_KEY=
TTS_MODEL=FunAudioLLM/CosyVoice2-0.5B
TTS_VOICE=diana

# 朗诵供应商：cosyvoice(硅基流动) / volcano_bigtts / volcano / azure / openai
TTS_PROVIDER=cosyvoice
# 豆包大模型语音（seed-tts，只需一个 X-Api-Key，无需 AppID）
VOLC_API_KEY=bf9afbbb-160a-4d4b-9299-3d64fa30678a
# 资源 ID 须与音色同代：uranus/saturn → seed-tts-2.0，mars/moon → seed-tts-1.0
# 当前密钥只开通了 2.0，1.0 音色会在握手阶段被拒绝。
VOLC_RESOURCE_ID=seed-tts-2.0
# 2.0 音色（已用当前密钥试通）
VOLC_SPEAKER=zh_female_vv_uranus_bigtts
# 语速：-50~100，负值更慢；诗词朗诵建议 -25 左右
VOLC_SPEECH_RATE=-25
# 情感需所选音色支持。1.0 可用 happy/sad/angry/surprised/fear/hate/excited/coldness/neutral，留空=音色默认
VOLC_BIG_EMOTION=

# Azure 语音服务（zh-CN-XiaoxiaoNeural 支持 poetry-reading 诗歌朗诵风格）
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus
AZURE_VOICE=zh-CN-XiaoxiaoNeural
AZURE_STYLE=poetry-reading

# 字节火山引擎·经典语音合成（需 AppID + Access Token，音色需在应用下开通）
VOLC_APPID=
VOLC_ACCESS_TOKEN=
VOLC_CLUSTER=volcano_tts
VOLC_VOICE_TYPE=BV001_streaming
# 可选情感（需所选音色支持多情感），如 sad / happy / 留空
VOLC_EMOTION=

# 文生图（人物水墨插画，OpenAI 兼容 /images/generations）。为空则不生成插画。
# 方案A推荐：硅基流动 Kolors，与上面的 LLM 共用同一个硅基流动 key（一个平台搞定文本+图）。
# DeepSeek 无文生图，故用同平台的 Kolors 出图；OpenAI 可改 dall-e-3。
IMG_BASE_URL=https://api.siliconflow.cn/v1
IMG_API_KEY=sk-yzqxlupikjrsizolztmhgehrbtlijnanjnspkxmgewaxqepy
IMG_MODEL=Kwai-Kolors/Kolors
IMG_SIZE=1024x1024
# 插画检索：baidu=先用百度图片检索现成国画(大模型生成检索词)，取不到再按诗意生成；off=直接生成
IMG_SEARCH=baidu

# 激励视频广告位 ID（小程序流量主后台创建，形如 adunit-xxxx）。为空则非会员无法通过广告换对话次数。
REWARD_AD_UNIT=

# 小程序虚拟支付。在 MP「虚拟支付 → 基础配置」查看 OfferID、现网 AppKey。
# 道具管理里创建一个会员道具，道具 ID 填到 WX_VP_PRODUCT_ID，价格必须与 member_month_price 一致（单位分）。
# 发货推送地址填：https://golang-iyjf-344746-6-1528738627.sh.run.tcloudbase.com/api/pay/notify
WX_VP_OFFER_ID=
WX_VP_APP_KEY=
WX_VP_PRODUCT_ID=
WX_VP_ENV=0
